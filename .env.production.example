APP_NAME="Koperasi Simpan Pinjam KPRI MTsN 3 Kota Padang"
APP_ENV=production
APP_KEY= # Generate via: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://kpri.mtsn3padang.sch.id
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kpri_koperasi_prod
DB_USERNAME=kpri_db_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=koperasi@mtsn3padang.sch.id
MAIL_PASSWORD=GANTI_DENGAN_APP_PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="koperasi@mtsn3padang.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
